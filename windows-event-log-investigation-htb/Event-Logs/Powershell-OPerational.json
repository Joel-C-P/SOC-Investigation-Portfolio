dLayerData($targetPath,\r\n                                       $fileIdInfo[0],\r\n                                       ($finalCompatMode.Split($delimiters.ToCharArray()) | where { $_ -ne \"\" -and $_ -ne \"~^\" -and $_ -ne \"^\" }))\r\n}\r\n\r\n# Handle cancel event\r\nfinally\r\n{\r\n    if(($originalCompatMode -ne $null) -and ($verifyResponse -eq \"Verify_TRYAGAIN\"))\r\n    {\r\n        [WerUtil]::OverwriteCompatMode($targetPath, $originalCompatMode)\r\n    }\r\n}\r\n","ScriptBlockId":"8d748d50-b89b-4091-abb9-87e8893c1635","Path":"C:\\Windows\\TEMP\\SDIAG_dea1b29f-9c24-4c97-b8c2-6bcff5cf68b6\\RS_ProgramCompatibilityWizard.ps1"}}}
